# ReleaseGuard Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Django Core Settings
# =============================================================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Database Settings
# =============================================================================
# SQLite (development)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (production)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# =============================================================================
# Email Settings
# =============================================================================
# Console backend (development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ReleaseGuard <noreply@releaseguard.local>

# SMTP (production)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# EMAIL_USE_TLS=True

# =============================================================================
# Docker/Production Settings
# =============================================================================
# PostgreSQL
POSTGRES_PASSWORD=your-secure-postgres-password

# Allowed hosts for production (comma-separated)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# SMTP (production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# =============================================================================
# Optional: Monitoring & Integrations
# =============================================================================
# Sentry (error tracking)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# GitHub (for GitHub App integration)
# GITHUB_APP_ID=12345
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Slack (notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx